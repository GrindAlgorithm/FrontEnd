# 프로덕션 빌드(`npm run build`) 전용 — Vite 는 빌드 시 .env.development 를 읽지 않는다.
# 이 파일이 없으면 VITE_USE_MOCK 이 undefined 가 되어 src/api/index.ts 가 목 API 로 떨어지고,
# 배포된 사이트가 전부 가짜 데이터로 동작한다. 반드시 false 를 유지할 것.
VITE_USE_MOCK=false

# API 는 프론트와 같은 오리진에서 서빙된다(Caddy 가 /api/* 를 백엔드로 프록시).
# 다른 도메인의 백엔드를 쓸 때만 절대 URL 로 바꾼다.
VITE_API_BASE_URL=/api/v1
